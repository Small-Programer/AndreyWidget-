<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="Andrey Widget"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".AndreyWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.andrey.widget.ACTION_PREV" />
                <action android:name="com.andrey.widget.ACTION_NEXT" />
                <action android:name="com.andrey.widget.ACTION_REFRESH" />
                <action android:name="com.andrey.widget.ACTION_CLICK_1" />
                <action android:name="com.andrey.widget.ACTION_CLICK_2" />
                <action android:name="com.andrey.widget.UPDATE_LIST" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

    </application>

</manifest>
