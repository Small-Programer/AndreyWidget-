<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header estilo Waybar / Hyprland Glass -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/txt_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="⚡ ANDREY.OS"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Botón Refrescar con Ripple -->
        <TextView
            android:id="@+id/btn_refresh"
            android:layout_width="28dp"
            android:layout_height="26dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="🔄"
            android:textColor="#7DCFFF"
            android:textSize="12sp"
            android:background="@drawable/btn_neutral_bg"
            android:layout_marginEnd="6dp" />

        <!-- Botón Anterior con Ripple -->
        <TextView
            android:id="@+id/btn_prev"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/btn_neutral_bg"
            android:gravity="center"
            android:text="◀"
            android:textColor="#89B4FA"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Indicador de Página -->
        <TextView
            android:id="@+id/txt_page_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="1/1"
            android:textColor="#BAC2DE"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Botón Siguiente con Ripple -->
        <TextView
            android:id="@+id/btn_next"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/btn_neutral_bg"
            android:gravity="center"
            android:text="▶"
            android:textColor="#89B4FA"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Barra de Telemetría Linux Waybar Pill -->
    <LinearLayout
        android:id="@+id/status_matrix"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/status_matrix_bg"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/chip_nginx"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="● Nginx :8081"
            android:textColor="#9ECE6A"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chip_node"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="● Node :3000"
            android:textColor="#7DCFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chip_domain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="🌐 andrey.homes"
            android:textColor="#BB9AF7"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Estado Vacío -->
    <LinearLayout
        android:id="@+id/layout_empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/btn_action_empty"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/btn_card_start_bg"
            android:gravity="center"
            android:text="🔄 Sincronizar con Termux..."
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bento Grid 2x2 Glass Cards -->
    <LinearLayout
        android:id="@+id/grid_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Fila 1 -->
        <LinearLayout
            android:id="@+id/row_1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <!-- Tarjeta 1 -->
            <LinearLayout
                android:id="@+id/card_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/btn_card_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="7dp"
                android:layout_marginEnd="4dp">

                <TextView
                    android:id="@+id/card_icon_1"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/badge_icon_bg"
                    android:gravity="center"
                    android:text="⚡"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="7dp">

                    <TextView
                        android:id="@+id/card_title_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Acción 1"
                        android:textColor="#EEF1F8"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/card_sub_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Script"
                        android:textColor="#89B4FA"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tarjeta 2 -->
            <LinearLayout
                android:id="@+id/card_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/btn_card_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="7dp"
                android:layout_marginStart="4dp">

                <TextView
                    android:id="@+id/card_icon_2"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/badge_icon_bg"
                    android:gravity="center"
                    android:text="⚡"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="7dp">

                    <TextView
                        android:id="@+id/card_title_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Acción 2"
                        android:textColor="#EEF1F8"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/card_sub_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Script"
                        android:textColor="#89B4FA"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Fila 2 -->
        <LinearLayout
            android:id="@+id/row_2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Tarjeta 3 -->
            <LinearLayout
                android:id="@+id/card_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/btn_card_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="7dp"
                android:layout_marginEnd="4dp">

                <TextView
                    android:id="@+id/card_icon_3"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/badge_icon_bg"
                    android:gravity="center"
                    android:text="⚡"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="7dp">

                    <TextView
                        android:id="@+id/card_title_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Acción 3"
                        android:textColor="#EEF1F8"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/card_sub_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Script"
                        android:textColor="#89B4FA"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Tarjeta 4 -->
            <LinearLayout
                android:id="@+id/card_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/btn_card_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="7dp"
                android:layout_marginStart="4dp">

                <TextView
                    android:id="@+id/card_icon_4"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/badge_icon_bg"
                    android:gravity="center"
                    android:text="⚡"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="7dp">

                    <TextView
                        android:id="@+id/card_title_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Acción 4"
                        android:textColor="#EEF1F8"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/card_sub_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Script"
                        android:textColor="#89B4FA"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Footer -->
    <TextView
        android:id="@+id/txt_category"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:text="TERMUX SHORTCUTS"
        android:textColor="#9AA5BD"
        android:textSize="9sp"
        android:textStyle="bold" />

</LinearLayout>
